# AI Life OS · LLM environment configuration (copy to .env and fill in; .env never enters git)
# Recommended: run ./setup-llm.sh to generate it interactively; the key input is not echoed.
# Any OpenAI-compatible service works; to switch services, just change these 4 values.

# Anything other than mock enables the real LLM (e.g. openai / deepseek / kimi / zhipu / xiaomi)
AI_LIFE_OS_LLM_PROVIDER=xiaomi
# OpenAI-compatible base_url (ending in /v1)
AI_LIFE_OS_LLM_BASE_URL=https://api.xiaomimimo.com/v1
# Model name
AI_LIFE_OS_LLM_MODEL=mimo-v2.6-pro
# API Key (keep secret; stored only in this file, mode 600)
AI_LIFE_OS_LLM_API_KEY=
