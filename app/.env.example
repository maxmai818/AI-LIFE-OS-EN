# AI Life OS · LLM 环境配置（复制为 .env 后填写；.env 永不进 git）
# 推荐直接运行 ./setup-llm.sh 交互生成，密钥输入不回显。
# 任何 OpenAI 兼容服务都可用，换服务只改这 4 个值。

# 非 mock 即启用真实 LLM（如 openai / deepseek / kimi / zhipu / xiaomi）
AI_LIFE_OS_LLM_PROVIDER=xiaomi
# OpenAI 兼容 base_url（以 /v1 结尾）
AI_LIFE_OS_LLM_BASE_URL=https://api.xiaomimimo.com/v1
# 模型名
AI_LIFE_OS_LLM_MODEL=mimo-v2.6-pro
# API Key（保密；只存本文件，权限 600）
AI_LIFE_OS_LLM_API_KEY=
